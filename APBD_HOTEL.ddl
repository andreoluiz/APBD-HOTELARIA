CREATE OR REPLACE VIEW HOTEL_GESTAO.VW_AUDITORIA_DETALHADA ( COD_USUARIO, COD_HOTEL, COD_SETOR, COD_AUDITORIA_EVENTO, NUM_IP, DSC_EVENTO, COD_ENTIDADE, NOM_ENTIDADE, DSC_OPERACAO, NOM_USUARIO, NOM_HOTEL, NOM_SETOR, COD_AUDITORIA_ALTERACAO, NOM_TABELA, COD_REGISTRO, NOM_CAMPO, DSC_VALOR_ANTERIOR, DSC_VALOR_NOVO, DT_EVENTO ) AS
SELECT HOTEL_GESTAO.TB_USUARIO.COD_USUARIO AS COD_USUARIO,
  HOTEL_GESTAO.TB_HOTEL.COD_HOTEL AS COD_HOTEL,
  HOTEL_GESTAO.TB_SETOR.COD_SETOR,
  HOTEL_GESTAO.TB_AUDITORIA_EVENTO.COD_AUDITORIA_EVENTO,
  HOTEL_GESTAO.TB_AUDITORIA_EVENTO.NUM_IP,
  HOTEL_GESTAO.TB_AUDITORIA_EVENTO.DSC_EVENTO,
  HOTEL_GESTAO.TB_AUDITORIA_EVENTO.COD_ENTIDADE,
  HOTEL_GESTAO.TB_AUDITORIA_EVENTO.NOM_ENTIDADE,
  HOTEL_GESTAO.TB_AUDITORIA_EVENTO.DSC_OPERACAO,
  HOTEL_GESTAO.TB_USUARIO.NOM_USUARIO,
  HOTEL_GESTAO.TB_HOTEL.NOM_HOTEL,
  HOTEL_GESTAO.TB_SETOR.NOM_SETOR,
  HOTEL_GESTAO.TB_AUDITORIA_ALTERACAO.COD_AUDITORIA_ALTERACAO,
  HOTEL_GESTAO.TB_AUDITORIA_ALTERACAO.NOM_TABELA,
  HOTEL_GESTAO.TB_AUDITORIA_ALTERACAO.COD_REGISTRO,
  HOTEL_GESTAO.TB_AUDITORIA_ALTERACAO.NOM_CAMPO,
  HOTEL_GESTAO.TB_AUDITORIA_ALTERACAO.DSC_VALOR_ANTERIOR,
  HOTEL_GESTAO.TB_AUDITORIA_ALTERACAO.DSC_VALOR_NOVO,
  HOTEL_GESTAO.TB_AUDITORIA_EVENTO.DT_EVENTO
FROM HOTEL_GESTAO.TB_AUDITORIA_EVENTO
  LEFT JOIN HOTEL_GESTAO.TB_AUDITORIA_ALTERACAO ON HOTEL_GESTAO.TB_AUDITORIA_EVENTO.COD_AUDITORIA_EVENTO =
    HOTEL_GESTAO.TB_AUDITORIA_ALTERACAO.COD_AUDITORIA_EVENTO
  LEFT JOIN HOTEL_GESTAO.TB_USUARIO
    ON HOTEL_GESTAO.TB_USUARIO.COD_USUARIO = HOTEL_GESTAO.TB_AUDITORIA_EVENTO.COD_USUARIO
  LEFT JOIN HOTEL_GESTAO.TB_HOTEL ON HOTEL_GESTAO.TB_HOTEL.COD_HOTEL = HOTEL_GESTAO.TB_AUDITORIA_EVENTO.COD_HOTEL
  LEFT JOIN HOTEL_GESTAO.TB_SETOR ON HOTEL_GESTAO.TB_SETOR.COD_SETOR = HOTEL_GESTAO.TB_AUDITORIA_EVENTO.COD_SETOR 
;

CREATE OR REPLACE VIEW HOTEL_GESTAO.VW_RESUMO_PROTOCOLO_SETOR ( DSC_STATUS, DSC_PRIORIDADE, COD_HOTEL, NOM_HOTEL, COD_SETOR, NOM_SETOR, QTD_PROTOCOLOS, DT_PROTOCOLO_MAIS_ANTIGO, DT_PROTOCOLO_MAIS_RECENTE ) AS
SELECT HOTEL_GESTAO.TB_PROTOCOLO.DSC_STATUS,
  HOTEL_GESTAO.TB_PROTOCOLO.DSC_PRIORIDADE,
  HOTEL_GESTAO.TB_HOTEL.COD_HOTEL,
  HOTEL_GESTAO.TB_HOTEL.NOM_HOTEL,
  HOTEL_GESTAO.TB_SETOR.COD_SETOR,
  HOTEL_GESTAO.TB_SETOR.NOM_SETOR,
  Count(HOTEL_GESTAO.TB_PROTOCOLO.COD_PROTOCOLO) AS QTD_PROTOCOLOS,
  Min(HOTEL_GESTAO.TB_PROTOCOLO.DT_ABERTURA) AS DT_PROTOCOLO_MAIS_ANTIGO,
  Max(HOTEL_GESTAO.TB_PROTOCOLO.DT_ABERTURA) AS DT_PROTOCOLO_MAIS_RECENTE
FROM HOTEL_GESTAO.TB_PROTOCOLO
  INNER JOIN HOTEL_GESTAO.TB_HOTEL ON HOTEL_GESTAO.TB_HOTEL.COD_HOTEL = HOTEL_GESTAO.TB_PROTOCOLO.COD_HOTEL
  INNER JOIN HOTEL_GESTAO.TB_SETOR ON HOTEL_GESTAO.TB_SETOR.COD_SETOR = HOTEL_GESTAO.TB_PROTOCOLO.COD_SETOR_ATUAL
GROUP BY HOTEL_GESTAO.TB_PROTOCOLO.DSC_STATUS,
  HOTEL_GESTAO.TB_PROTOCOLO.DSC_PRIORIDADE,
  HOTEL_GESTAO.TB_HOTEL.COD_HOTEL,
  HOTEL_GESTAO.TB_HOTEL.NOM_HOTEL,
  HOTEL_GESTAO.TB_SETOR.COD_SETOR,
  HOTEL_GESTAO.TB_SETOR.NOM_SETOR 
;

CREATE OR REPLACE VIEW HOTEL_GESTAO.VW_USUARIO_CONSULTA ( COD_USUARIO, NOM_USUARIO, DSC_EMAIL, DSC_SITUACAO, DT_CRIACAO, DT_ULTIMO_LOGIN, DT_ATUALIZACAO ) AS
SELECT HOTEL_GESTAO.TB_USUARIO.COD_USUARIO,
  HOTEL_GESTAO.TB_USUARIO.NOM_USUARIO,
  HOTEL_GESTAO.TB_USUARIO.DSC_EMAIL,
  HOTEL_GESTAO.TB_USUARIO.DSC_SITUACAO,
  HOTEL_GESTAO.TB_USUARIO.DT_CRIACAO,
  HOTEL_GESTAO.TB_USUARIO.DT_ULTIMO_LOGIN,
  HOTEL_GESTAO.TB_USUARIO.DT_ATUALIZACAO
FROM HOTEL_GESTAO.TB_USUARIO 
;

CREATE OR REPLACE TRIGGER HOTEL_GESTAO.TRG_AUD_ALT_BI 
BEFORE INSERT ON HOTEL_GESTAO.TB_AUDITORIA_ALTERACAO 
FOR EACH ROW 
WHEN (NEW.COD_AUDITORIA_ALTERACAO IS NULL) 
BEGIN 
    :NEW.COD_AUDITORIA_ALTERACAO := HOTEL_GESTAO.SEQ_COD_AUDITORIA_ALTERACAO.NEXTVAL; 
END;
/

