CREATE TABLE HOTEL_GESTAO.TB_SETOR 
    ( 
     COD_SETOR  NUMBER (19) 
         CONSTRAINT NN_COD_SETOR NOT NULL , 
     COD_HOTEL  NUMBER (19) 
         CONSTRAINT NN_SET_COD_HOTEL NOT NULL , 
     NOM_SETOR  VARCHAR2 (150 BYTE) 
         CONSTRAINT NN_NOM_SETOR NOT NULL , 
     SIG_SETOR  VARCHAR2 (20 BYTE) , 
     DSC_SETOR  VARCHAR2 (300 BYTE) , 
     IND_ATIVO  NUMBER (1) DEFAULT 1 
         CONSTRAINT NN_SET_ATIVO NOT NULL , 
     DT_CRIACAO TIMESTAMP 
         CONSTRAINT NN_SET_CRIACAO NOT NULL 
    ) 
        PCTFREE 10 
        PCTUSED 40 
        TABLESPACE USERS 
        LOGGING 
        STORAGE ( 
        PCTINCREASE 0 
        MINEXTENTS 1 
        MAXEXTENTS UNLIMITED 
        FREELISTS 1 
        FREELIST GROUPS 1 
        BUFFER_POOL DEFAULT 
    ) 
    NO INMEMORY 
;

ALTER TABLE HOTEL_GESTAO.TB_SETOR 
    ADD CONSTRAINT CK_SETOR_ATIVO 
    CHECK (IND_ATIVO IN (0, 1)) 
;
