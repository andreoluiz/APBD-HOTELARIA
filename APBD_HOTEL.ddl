CREATE OR REPLACE TRIGGER HOTEL_GESTAO.TRG_USUARIO_BI 
BEFORE INSERT ON HOTEL_GESTAO.TB_USUARIO 
FOR EACH ROW 
WHEN (NEW.COD_USUARIO IS NULL) 
BEGIN 
    :NEW.COD_USUARIO := HOTEL_GESTAO.SEQ_COD_USUARIO.NEXTVAL; 
END;
/



