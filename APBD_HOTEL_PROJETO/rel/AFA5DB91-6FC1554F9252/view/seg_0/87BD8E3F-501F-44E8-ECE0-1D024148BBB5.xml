<userDefinedSQL><![CDATA[CREATE OR REPLACE VIEW VW_RESUMO_PROTOCOLO_SETOR
AS 
SELECT HOTEL_GESTAO.TB_PROTOCOLO.DSC_STATUS,
  HOTEL_GESTAO.TB_PROTOCOLO.DSC_PRIORIDADE,
  HOTEL_GESTAO.TB_HOTEL.COD_HOTEL,
  HOTEL_GESTAO.TB_HOTEL.NOM_HOTEL,
  HOTEL_GESTAO.TB_SETOR.COD_SETOR,
  HOTEL_GESTAO.TB_SETOR.NOM_SETOR,
  Count(HOTEL_GESTAO.TB_PROTOCOLO.COD_PROTOCOLO) AS QTD_PROTOCOLOS,
  Min(HOTEL_GESTAO.TB_PROTOCOLO.DT_ABERTURA) AS DT_PROTOCOLO_MAIS_ANTIGO,
  Max(HOTEL_GESTAO.TB_PROTOCOLO.DT_ABERTURA) AS DT_PROTOCOLO_MAIS_RECENTE
FROM HOTEL_GESTAO.TB_PROTOCOLO
  INNER JOIN HOTEL_GESTAO.TB_HOTEL ON HOTEL_GESTAO.TB_HOTEL.COD_HOTEL = HOTEL_GESTAO.TB_PROTOCOLO.COD_HOTEL
  INNER JOIN HOTEL_GESTAO.TB_SETOR ON HOTEL_GESTAO.TB_SETOR.COD_SETOR = HOTEL_GESTAO.TB_PROTOCOLO.COD_SETOR_ATUAL
GROUP BY HOTEL_GESTAO.TB_PROTOCOLO.DSC_STATUS,
  HOTEL_GESTAO.TB_PROTOCOLO.DSC_PRIORIDADE,
  HOTEL_GESTAO.TB_HOTEL.COD_HOTEL,
  HOTEL_GESTAO.TB_HOTEL.NOM_HOTEL,
  HOTEL_GESTAO.TB_SETOR.COD_SETOR,
  HOTEL_GESTAO.TB_SETOR.NOM_SETOR]]></userDefinedSQL>
